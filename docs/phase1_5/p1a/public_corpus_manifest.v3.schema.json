{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "public_corpus_manifest.v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "parent_corpus_id", "supersedes_reason", "status", "external_evidence_root_id", "source_repository", "approved_count", "quarantine_count", "minimum_required_count", "allowed_license_ids", "privacy_policy", "age_policy", "required_categories", "samples", "quarantine", "aggregate"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "corpus_id": {"type": "string", "pattern": "^phase1-5-p1a-public-corpus-[0-9]{8}T[0-9]{6}Z-r3$"},
    "parent_corpus_id": {"type": "string", "minLength": 1},
    "supersedes_reason": {"type": "string", "minLength": 1},
    "status": {"const": "CORPUS_R3_VALIDATED"},
    "external_evidence_root_id": {"type": "string", "pattern": "^public-corpus-[0-9]{8}T[0-9]{6}Z-r3$"},
    "source_repository": {"type": "string", "minLength": 1},
    "approved_count": {"type": "integer", "minimum": 20},
    "quarantine_count": {"type": "integer", "minimum": 1},
    "minimum_required_count": {"const": 20},
    "allowed_license_ids": {"type": "array", "uniqueItems": true, "items": {"enum": ["CC0", "Public-Domain", "CC-BY-4.0"]}},
    "privacy_policy": {"type": "object", "additionalProperties": false, "required": ["owner_media"], "properties": {"owner_media": {"const": "prohibited"}}},
    "age_policy": {"type": "object", "additionalProperties": false, "required": ["approved_human_presence"], "properties": {"approved_human_presence": {"type": "array", "uniqueItems": true, "items": {"enum": ["NONE", "VISIBLE_DOCUMENTED_ADULT"]}}}},
    "required_categories": {"type": "array", "minItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "samples": {"type": "array", "minItems": 20, "items": {"$ref": "#/$defs/sample"}},
    "quarantine": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quarantine"}},
    "aggregate": {"type": "object", "additionalProperties": false, "required": ["algorithm", "sha256"], "properties": {"algorithm": {"const": "sha256/canonical-json-v3"}, "sha256": {"$ref": "#/$defs/hash"}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "url": {"type": "string", "pattern": "^https://[^\\s]+$"},
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "safePath": {"type": "string", "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "transport": {"type": "object", "additionalProperties": false, "required": ["url", "final_url", "status", "content_type", "bytes", "sha256", "retrieved_utc", "attempt"], "properties": {"url": {"$ref": "#/$defs/url"}, "final_url": {"$ref": "#/$defs/url"}, "status": {"const": 200}, "content_type": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}, "retrieved_utc": {"$ref": "#/$defs/utc"}, "attempt": {"type": "integer", "minimum": 1}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["relative_path", "sha256", "bytes", "mime", "representation", "original_url", "parent_corpus_id", "width", "height"], "properties": {"relative_path": {"$ref": "#/$defs/safePath"}, "sha256": {"$ref": "#/$defs/hash"}, "bytes": {"type": "integer", "minimum": 1}, "mime": {"type": "string", "minLength": 1}, "representation": {"type": "string", "minLength": 1}, "original_url": {"$ref": "#/$defs/url"}, "parent_corpus_id": {"type": "string", "minLength": 1}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "sanitized": {"type": "object", "additionalProperties": false, "required": ["relative_path", "format", "mime", "bytes", "sha256", "dimensions", "source_dimensions", "source_orientation", "orientation_normalized", "crop_applied", "exif_removed", "gps_removed", "device_metadata_removed", "software_metadata_removed"], "properties": {"relative_path": {"$ref": "#/$defs/safePath"}, "format": {"const": "JPEG"}, "mime": {"const": "image/jpeg"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}, "dimensions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}, "source_dimensions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}, "source_orientation": {"type": "integer", "minimum": 1, "maximum": 8}, "orientation_normalized": {"type": "boolean"}, "crop_applied": {"const": false}, "exif_removed": {"const": true}, "gps_removed": {"const": true}, "device_metadata_removed": {"const": true}, "software_metadata_removed": {"const": true}}},
    "sourcePage": {"type": "object", "additionalProperties": false, "required": ["pageid", "title", "revision_id", "revision_timestamp", "canonical_url", "original_url", "mime", "width", "height", "artist", "credit", "attribution", "commons_api_sha256", "metadata_request_url", "metadata_request_final_url", "retrieved_utc"], "properties": {"pageid": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1}, "revision_id": {"type": "integer", "minimum": 1}, "revision_timestamp": {"$ref": "#/$defs/utc"}, "canonical_url": {"$ref": "#/$defs/url"}, "original_url": {"$ref": "#/$defs/url"}, "mime": {"type": "string", "minLength": 1}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "artist": {"type": "string"}, "credit": {"type": "string"}, "attribution": {"type": "string"}, "commons_api_sha256": {"$ref": "#/$defs/hash"}, "metadata_request_url": {"$ref": "#/$defs/url"}, "metadata_request_final_url": {"$ref": "#/$defs/url"}, "retrieved_utc": {"$ref": "#/$defs/utc"}}},
    "attribution": {"type": "object", "additionalProperties": false, "required": ["author", "title", "page_url", "license_name", "license_url", "modified", "recommended_attribution"], "properties": {"author": {"type": "string"}, "title": {"type": "string", "minLength": 1}, "page_url": {"$ref": "#/$defs/url"}, "license_name": {"type": "string", "minLength": 1}, "license_url": {"$ref": "#/$defs/url"}, "modified": {"type": "string", "minLength": 1}, "recommended_attribution": {"type": "string", "minLength": 1}}},
    "license": {"type": "object", "additionalProperties": false, "required": ["id", "name", "url", "attribution"], "properties": {"id": {"enum": ["CC0", "Public-Domain", "CC-BY-4.0"]}, "name": {"type": "string", "minLength": 1}, "url": {"$ref": "#/$defs/url"}, "attribution": {"$ref": "#/$defs/attribution"}}},
    "humanReview": {"type": "object", "additionalProperties": false, "required": ["status", "review_scope", "human_presence", "person_count", "full_body_count", "age_evidence_basis", "age_evidence", "nonvisual_source", "no_person", "note"], "properties": {"status": {"const": "APPROVED"}, "review_scope": {"type": "string", "minLength": 1}, "human_presence": {"enum": ["NONE", "VISIBLE_DOCUMENTED_ADULT"]}, "person_count": {"type": "integer", "minimum": 0}, "full_body_count": {"type": "integer", "minimum": 0}, "age_evidence_basis": {"type": "string", "minLength": 1}, "age_evidence": {"type": "string", "minLength": 1}, "nonvisual_source": {"$ref": "#/$defs/url"}, "no_person": {"type": "boolean"}, "note": {"type": "string", "minLength": 1}}},
    "metadataEvidence": {"type": "object", "additionalProperties": false, "required": ["evidence_type", "relative_path", "bytes", "sha256"], "properties": {"evidence_type": {"enum": ["COMMONS_API", "SOURCE_PAGE_RECORD", "LICENSE_EVIDENCE", "TRANSPORT", "MANUAL_VISUAL_REVIEW"]}, "relative_path": {"$ref": "#/$defs/safePath"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "sample": {"type": "object", "additionalProperties": false, "required": ["sample_id", "title", "status", "category_tags", "source", "sanitized", "source_page", "license", "human_review", "metadata_evidence"], "properties": {"sample_id": {"type": "string", "pattern": "^p1a-[0-9]{3}$"}, "title": {"type": "string", "minLength": 1}, "status": {"const": "APPROVED"}, "category_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "source": {"$ref": "#/$defs/source"}, "sanitized": {"$ref": "#/$defs/sanitized"}, "source_page": {"$ref": "#/$defs/sourcePage"}, "license": {"$ref": "#/$defs/license"}, "human_review": {"$ref": "#/$defs/humanReview"}, "metadata_evidence": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/metadataEvidence"}, "allOf": [{"contains": {"type": "object", "properties": {"evidence_type": {"const": "COMMONS_API"}}, "required": ["evidence_type"]}, "minContains": 1, "maxContains": 1}, {"contains": {"type": "object", "properties": {"evidence_type": {"const": "SOURCE_PAGE_RECORD"}}, "required": ["evidence_type"]}, "minContains": 1, "maxContains": 1}, {"contains": {"type": "object", "properties": {"evidence_type": {"const": "LICENSE_EVIDENCE"}}, "required": ["evidence_type"]}, "minContains": 1, "maxContains": 1}, {"contains": {"type": "object", "properties": {"evidence_type": {"const": "TRANSPORT"}}, "required": ["evidence_type"]}, "minContains": 1, "maxContains": 1}, {"contains": {"type": "object", "properties": {"evidence_type": {"const": "MANUAL_VISUAL_REVIEW"}}, "required": ["evidence_type"]}, "minContains": 1, "maxContains": 1}]}}},
    "quarantine": {"type": "object", "additionalProperties": false, "required": ["sample_id", "status", "reason", "old_source_sha256", "old_sanitized_sha256", "no_image_copied"], "properties": {"sample_id": {"type": "string", "pattern": "^p1a-[0-9]{3}$"}, "status": {"const": "QUARANTINED"}, "reason": {"type": "string", "minLength": 1}, "old_source_sha256": {"$ref": "#/$defs/hash"}, "old_sanitized_sha256": {"$ref": "#/$defs/hash"}, "no_image_copied": {"const": true}}}
  }
}
