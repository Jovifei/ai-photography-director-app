{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoai.local/phase1_5/t9/ready_promotion_decision.v1.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["decision_version", "reference_id", "source_class", "decision", "trusted_ready_guidance_allowed", "blockers", "product_action", "demo_fallback_policy", "policy_version"],
  "properties": {
    "decision_version": {"const": "1.0.0"}, "reference_id": {"type": "string"}, "source_class": {"enum": ["SYNTHETIC_CONTRACT_ONLY", "REAL_PROVIDER_RESULT", "DEMO", "UNAVAILABLE"]},
    "decision": {"enum": ["NOT_APPLICABLE_NON_SUCCESS", "BLOCKED_SYNTHETIC_EVIDENCE", "BLOCKED_CONTRACT_INVALID", "BLOCKED_EVALUATION_INVALID", "BLOCKED_PIPELINE_COMPATIBILITY_NOT_AUTHORIZED", "BLOCKED_ADJUDICATION_REQUIRED", "BLOCKED_SEVERE_FINDING", "BLOCKED_THRESHOLD_NOT_APPROVED", "BLOCKED_PROVIDER_NOT_QUALIFIED", "BLOCKED_HUMAN_REVIEW_NOT_AUTHORIZED", "BLOCKED_PRODUCT_PROMOTION_NOT_AUTHORIZED", "ELIGIBLE_AFTER_ALL_REQUIRED_GATES"]},
    "trusted_ready_guidance_allowed": {"type": "boolean"}, "blockers": {"type": "array", "items": {"type": "string"}}, "product_action": {"enum": ["SHOW_UNAVAILABLE", "SHOW_DEMO_ONLY", "ALLOW_READY_GUIDANCE"]},
    "demo_fallback_policy": {"const": "USER_EXPLICIT_OUT_OF_ENVELOPE_ONLY"}, "policy_version": {"const": "1.0.0"}
  }
}
