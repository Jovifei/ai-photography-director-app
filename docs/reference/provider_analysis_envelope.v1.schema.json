{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoai.local/drafts/provider_analysis_envelope.v1.schema.json",
  "title": "ProviderAnalysisEnvelope v1",
  "description": "Private-to-provider operational metadata. It never carries image bytes, image URI/path, credentials, account identifiers, device serials, or precise location.",
  "type": "object",
  "additionalProperties": false,
  "required": ["envelope_version", "request_id", "reference_id", "provider_id", "provider_type", "model_id", "model_revision", "model_artifact_sha256", "runtime_id", "started_at_utc", "completed_at_utc", "latency_ms", "status", "output_schema_version", "bundle", "confidence_summary", "uncertainty_flags", "warnings", "provenance", "safety_flags", "retryable", "error"],
  "properties": {
    "envelope_version": { "const": "1.0" },
    "request_id": { "$ref": "#/$defs/opaqueId" },
    "reference_id": { "$ref": "#/$defs/opaqueId" },
    "provider_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "provider_type": { "enum": ["PIPELINE", "LOCAL_SERVICE", "CLOUD", "ON_DEVICE"] },
    "model_id": { "type": ["string", "null"], "maxLength": 256 },
    "model_revision": { "type": ["string", "null"], "maxLength": 256 },
    "model_artifact_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
    "runtime_id": { "type": ["string", "null"], "maxLength": 256 },
    "started_at_utc": { "type": "string", "format": "date-time" },
    "completed_at_utc": { "type": "string", "format": "date-time" },
    "latency_ms": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["SUCCESS", "FAILED", "CANCELLED"] },
    "output_schema_version": { "type": ["string", "null"], "maxLength": 32 },
    "bundle": { "oneOf": [{ "type": "null" }, { "$ref": "https://photoai.local/drafts/reference_bundle.v1.schema.json" }] },
    "confidence_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["direct_observation_fields", "photographic_interpretation_fields", "creative_recommendation_fields"],
      "properties": {
        "direct_observation_fields": { "$ref": "#/$defs/fieldList" },
        "photographic_interpretation_fields": { "$ref": "#/$defs/fieldList" },
        "creative_recommendation_fields": { "$ref": "#/$defs/fieldList" }
      },
      "description": "Field/basis summary, not a fabricated single confidence percentage."
    },
    "uncertainty_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["scene", "background_story", "lighting", "composition", "subject_intent", "emotion", "pose_template", "camera_position", "director_prompt"],
      "properties": {
        "scene": { "$ref": "#/$defs/uncertainty" }, "background_story": { "$ref": "#/$defs/uncertainty" }, "lighting": { "$ref": "#/$defs/uncertainty" },
        "composition": { "$ref": "#/$defs/uncertainty" }, "subject_intent": { "$ref": "#/$defs/uncertainty" }, "emotion": { "$ref": "#/$defs/uncertainty" },
        "pose_template": { "$ref": "#/$defs/uncertainty" }, "camera_position": { "$ref": "#/$defs/uncertainty" }, "director_prompt": { "$ref": "#/$defs/uncertainty" }
      }
    },
    "warnings": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/shortText" } },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["result_origin", "producer_release", "input_media_retained", "raw_image_available", "direct_observation_fields", "photographic_interpretation_fields", "creative_recommendation_fields"],
      "properties": {
        "result_origin": { "enum": ["PIPELINE", "LOCAL_VLM", "CLOUD", "ON_DEVICE", "UNAVAILABLE"] },
        "producer_release": { "type": ["string", "null"], "maxLength": 128 },
        "input_media_retained": { "type": "boolean" }, "raw_image_available": { "type": "boolean" },
        "direct_observation_fields": { "$ref": "#/$defs/fieldList" }, "photographic_interpretation_fields": { "$ref": "#/$defs/fieldList" }, "creative_recommendation_fields": { "$ref": "#/$defs/fieldList" }
      }
    },
    "safety_flags": { "type": "array", "uniqueItems": true, "items": { "enum": ["NO_SAFETY_FLAGS", "PRIVACY_BLOCKED", "LICENSE_BLOCKED", "POLICY_REJECTED", "UNSUPPORTED_INPUT"] } },
    "retryable": { "type": "boolean" },
    "error": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["code", "user_message", "preserve_reference", "allow_safe_event_log", "allow_diagnostic_upload", "product_action"], "properties": {
          "code": { "enum": ["USER_CANCELLED", "REFERENCE_URI_UNAVAILABLE", "REFERENCE_PERMISSION_EXPIRED", "IMAGE_DECODE_FAILED", "IMAGE_UNSUPPORTED", "IMAGE_TOO_LARGE", "IMAGE_PRIVACY_BLOCKED", "PROVIDER_NOT_CONFIGURED", "PROVIDER_UNAVAILABLE", "PROVIDER_TIMEOUT", "PROVIDER_OOM", "PROVIDER_OUTPUT_EMPTY", "PROVIDER_OUTPUT_MALFORMED", "PROVIDER_OUTPUT_SCHEMA_INVALID", "PROVIDER_SAFETY_REJECTED", "PROVIDER_LICENSE_BLOCKED", "PIPELINE_BUNDLE_INCOMPATIBLE", "UNKNOWN_FAILURE"] },
          "user_message": { "$ref": "#/$defs/shortText" }, "preserve_reference": { "type": "boolean" }, "allow_safe_event_log": { "type": "boolean" }, "allow_diagnostic_upload": { "const": false },
          "product_action": { "enum": ["STOP", "RESELECT", "OFFER_RETRY", "SHOW_UNAVAILABLE", "EXPLICIT_DEMO_FALLBACK"] }
        }}
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "SUCCESS" } } }, "then": { "properties": { "bundle": { "$ref": "https://photoai.local/drafts/reference_bundle.v1.schema.json" }, "output_schema_version": { "const": "1.0" }, "error": { "type": "null" } } } },
    { "if": { "properties": { "status": { "enum": ["FAILED", "CANCELLED"] } } }, "then": { "properties": { "bundle": { "type": "null" }, "output_schema_version": { "type": "null" }, "error": { "type": "object" } } } }
  ],
  "$defs": {
    "opaqueId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\r\\n]+$" },
    "fieldName": { "enum": ["scene", "background_story", "lighting", "composition", "subject_intent", "emotion", "pose_template", "camera_position", "director_prompt"] },
    "fieldList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/fieldName" } },
    "uncertainty": { "type": "object", "additionalProperties": false, "required": ["level", "basis"], "properties": { "level": { "enum": ["LOW", "MEDIUM", "HIGH", "NOT_ASSESSED"] }, "basis": { "enum": ["DIRECT_OBSERVATION", "PHOTOGRAPHIC_INTERPRETATION", "CREATIVE_RECOMMENDATION", "INSUFFICIENT_EVIDENCE"] } } }
  }
}
